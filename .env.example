# ==============================================================================
# RMAA GitVault - Environment Configuration (.env.example)
# Add these Environment Variables directly in the Render Dashboard Settings.
# ==============================================================================

# Server Network Configuration
PORT=3000
GITEA__server__DOMAIN=pgit-jpw1.onrender.com
GITEA__server__ROOT_URL=https://pgit-jpw1.onrender.com/
GITEA__server__HTTP_PORT=3000
GITEA__server__DISABLE_SSH=true

# Keep-Alive Self-Ping Daemon URL (Bypasses Render 15-minute sleep)
KEEP_ALIVE_URL=https://pgit-jpw1.onrender.com/api/v1/version

# Supabase Postgres Pooled Database
GITEA__database__DB_TYPE=postgres
GITEA__database__HOST=aws-0-ap-northeast-2.pooler.supabase.com:6543
GITEA__database__NAME=postgres
GITEA__database__USER=postgres.sjjcilrjqavsgnqjjjlz
GITEA__database__PASSWD=YOUR_SUPABASE_PASSWORD
GITEA__database__SSL_MODE=require

# Hugging Face S3 Bucket Storage (Zero Local Disk Dependence)
GITEA__storage__STORAGE_TYPE=minio
GITEA__storage__MINIO_ENDPOINT=s3.huggingface.co
GITEA__storage__MINIO_ACCESS_KEY_ID=rmaapk
GITEA__storage__MINIO_SECRET_ACCESS_KEY=YOUR_HF_API_KEY
GITEA__storage__MINIO_BUCKET=rmaapk/pgit
GITEA__storage__MINIO_LOCATION=us-east-1
GITEA__storage__MINIO_USE_SSL=true

# Security & Registration
GITEA__security__INSTALL_LOCK=true
GITEA__security__SECRET_KEY=generate_random_secret_key_here
GITEA__service__DISABLE_REGISTRATION=false
GITEA__service__REQUIRE_SIGNIN_VIEW=false
